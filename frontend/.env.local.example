# Copy this file to `.env.local` to configure local dev (`pnpm dev`).
#
# When using `pnpm dev`, Next.js does NOT proxy `/api/*` to the backend.
# Set NEXT_PUBLIC_API_BASE so the browser bundle calls FastAPI directly.
# (Backend ships with CORS `*`, so cross-origin calls work.)
#
# When using Docker (`docker compose up`), leave this unset — Caddy proxies
# `/api/*` to backend:8000 transparently.
NEXT_PUBLIC_API_BASE=http://localhost:8000
